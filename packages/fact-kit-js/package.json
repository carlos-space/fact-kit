{
  "name": "fact-kit",
  "version": "0.9.0",
  "description": "Tooling to declare, check and build facts",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlos-space/fact-kit",
    "directory": "packages/fact-kit-js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "peerDependencies": {
    "oxc-parser": "^0.155.0",
    "typescript": ">=7.1.0-beta"
  },
  "peerDependenciesMeta": {
    "oxc-parser": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "bin": {
    "fact-kit": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "facts",
    "json-schema"
  ],
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.308",
    "oxc-parser": "^0.155.0",
    "typescript": "7.1.0-beta"
  }
}

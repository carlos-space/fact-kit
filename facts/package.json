{
  "name": "fact-kit-facts",
  "version": "0.3.0-alpha.2",
  "description": "Facts about fact-kit: the spec of its index format, commands and API",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlos-space/fact-kit",
    "directory": "facts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../packages/fact-kit-js/src/bin.ts build"
  },
  "devDependencies": {
    "@npm/fact-kit-facts": "workspace:*",
    "@pypi/fact-kit-facts": "workspace:*",
    "@crates/fact-kit-facts": "workspace:*",
    "@go/fact-kit-facts": "workspace:*",
    "@swift/fact-kit-facts": "workspace:*"
  },
  "exports": {
    "./index.json": "./dist/index.json",
    "./schemas/*": "./dist/schemas/*",
    "./fact-kit-py/index.json": "./dist/fact-kit-py/index.json",
    "./fact-kit-py/schemas/*": "./dist/fact-kit-py/schemas/*",
    "./fact-kit-rs/index.json": "./dist/fact-kit-rs/index.json",
    "./fact-kit-rs/schemas/*": "./dist/fact-kit-rs/schemas/*",
    "./fact-kit-go/index.json": "./dist/fact-kit-go/index.json",
    "./fact-kit-go/schemas/*": "./dist/fact-kit-go/schemas/*",
    "./fact-kit-swift/index.json": "./dist/fact-kit-swift/index.json",
    "./fact-kit-swift/schemas/*": "./dist/fact-kit-swift/schemas/*"
  }
}
